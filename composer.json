{
	"name": "chipasia/chip-for-sprout-invoices",
	"description": "CHIP payment gateway for Sprout Invoices.",
	"license": "GPL-3.0-or-later",
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"10up/wp_mock": "^1.1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs --standard=phpcs.xml .",
		"lint:fix": "phpcbf --standard=phpcs.xml .",
		"compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --extensions=php --ignore=vendor,node_modules ."
	}
}
